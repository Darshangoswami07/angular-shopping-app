{
  "name": "angular-shopping-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "dev:frontend": "npm run start --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:validate": "npm run prisma:validate --workspace=backend"
  },
  "engines": { "node": ">=22.12.0" }
}
