{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": { "#/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "generated/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}


