# Server
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# DATABASE_URL: pooled connection (PgBouncer) — used at runtime by the app.
# DIRECT_URL: direct, unpooled connection — used only for running migrations.
# Both are REQUIRED when NODE_ENV=production.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth
# REQUIRED when NODE_ENV=production. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
# Comma-separated list of frontend origins allowed to call this API.
# In development, localhost/127.0.0.1 on any port is always allowed regardless of this value.
ALLOWED_ORIGINS="http://localhost:4200"
